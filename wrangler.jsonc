{
  // Cloudflare Workers static site. Only files in ./public are published.
  "name": "nexpatchonline",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    // Unknown paths such as /consent load index.html, which handles them.
    "not_found_handling": "single-page-application"
  }
}
